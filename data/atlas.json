hauci","name":"Chauci","type":"tribe","family":"germanic","start":-100,"end":260,"summary":"Coastal Germanic people between the Ems and the Elbe, noted seafarers and pirates. Raided Gaul under Gannascus in 47, when Corbulo crushed them.","color":"#4B6647"},{"id":"cherusci","name":"Cherusci","type":"tribe","family":"germanic","start":-50,"end":100,"color":"#618C66"},{"id":"cilician_pirates","name":"Cilician pirates","type":"other","family":"anatolian","start":-140,"end":-67,"color":"#879DB0"},{"id":"cimbri_teutones","name":"Cimbri and Teutones","type":"nomadic","family":"germanic","start":-120,"end":-101,"color":"#608A64"},{"id":"clusium","name":"Clusium","type":"city_state","family":"etruscan","start":-800,"end":-280,"color":"#7D4B32"},{"id":"colchis","name":"Colchis / Lazica","type":"kingdom","family":"caucasian","start":-600,"end":641,"color":"#8593B4"},{"id":"commagene","name":"Kingdom of Commagene","type":"kingdom","family":"hellenistic","start":-163,"end":72,"color":"#266789"},{"id":"dacia_kingdom","name":"Dacian Kingdom","type":"kingdom","family":"thracian_dacian","start":-82,"end":106,"color":"#A3765C"},{"id":"dalmatae","name":"Dalmatae","type":"tribe","family":"illyrian","start":-300,"end":9,"color":"#6A4A44"},{"id":"durotriges","name":"Durotriges","type":"tribe","family":"british","start":-100,"end":45,"summary":"British people of Dorset and south Somerset with dense hillfort networks (Maiden Castle, Hod Hill) reduced by Vespasian and legio II Augusta in 43-47.","color":"#7AA28B"},{"id":"emesa","name":"Emesene dynasty","type":"client_kingdom","family":"semitic_arab","start":-64,"end":72,"color":"#9C7D50"},{"id":"epirus","name":"Epirus","type":"kingdom","family":"greek","start":-330,"end":-167,"color":"#3C7BAB"},{"id":"etruscans","name":"Etruscan city-states","type":"league","family":"etruscan","start":-800,"end":-264,"color":"#A57642"},{"id":"finnic_peoples","name":"Finnic peoples","type":"tribe","family":"other","start":-800,"end":641,"color":"#988E81"},{"id":"frankish_kingdom","name":"Frankish Kingdom (Merovingian)","type":"kingdom","family":"germanic","start":481,"end":641,"color":"#4E6E8E"},{"id":"franks","name":"Franks","type":"confederation","family":"germanic","start":240,"end":481,"color":"#4E6E8E"},{"id":"free_dacians","name":"Free Dacians (Carpi, Costoboci)","type":"tribe","family":"thracian_dacian","start":106,"end":300,"color":"#83564A"},{"id":"frisii","name":"Frisii","type":"tribe","family":"germanic","start":-100,"end":641,"color":"#5C845E"},{"id":"gaetuli","name":"Gaetuli","type":"tribe","family":"berber","start":-500,"end":641,"color":"#BC9663"},{"id":"galatia","name":"Galatians","type":"confederation","family":"gallic","start":-278,"end":-25,"color":"#7B9241"},{"id":"gallic_rebels_21","name":"Gallic rebels of Florus and Sacrovir","type":"confederation","family":"gallic","start":21,"end":21,"summary":"Short-lived revolt of indebted Aedui and Treveri under the Roman citizens Julius Sacrovir and Julius Florus in AD 21.","color":"#73823A"},{"id":"garamantes","name":"Garamantes","type":"kingdom","family":"berber","start":-500,"end":641,"color":"#C3A874"},{"id":"gauls","name":"Gallic tribes","type":"confederation","family":"gallic","start":-600,"end":-50,"color":"#85AD4E"},{"id":"gepids","name":"Gepids","type":"kingdom","family":"germanic","start":260,"end":567,"color":"#699670"},{"id":"germani","name":"Germanic tribes","type":"confederation","family":"germanic","start":-200,"end":641,"color":"#638E68"},{"id":"getae","name":"Getae","type":"tribe","family":"thracian_dacian","start":-600,"end":-50,"color":"#B69B7D"},{"id":"ghassanids","name":"Ghassanids","type":"client_kingdom","family":"semitic_arab","start":470,"end":638,"color":"#AF9962"},{"id":"goths","name":"Goths","type":"confederation","family":"germanic","start":200,"end":376,"color":"#557A55"},{"id":"greuthungi","name":"Greuthungi","type":"tribe","family":"germanic","start":250,"end":376,"color":"#5F8963"},{"id":"hasmonean","name":"Hasmonean Judaea","type":"kingdom","family":"semitic_arab","start":-140,"end":-37,"color":"#79573E"},{"id":"hatra","name":"Hatra","type":"kingdom","family":"semitic_arab","start":50,"end":241,"color":"#B3A26B"},{"id":"helvetii","name":"Helvetii","type":"tribe","family":"gallic","start":-300,"end":-58,"color":"#88B457"},{"id":"hephthalites","name":"Hephthalites","type":"nomadic","family":"steppe","start":440,"end":560,"color":"#9F8A60"},{"id":"hermunduri","name":"Hermunduri","type":"tribe","family":"germanic","start":-50,"end":400,"summary":"Suebic people on the upper Elbe and Saale, unusually friendly to Rome (Tacitus says they alone traded freely inside Raetia). Fought the Chatti over salt springs in AD 58 and joined the Marcomannic coalition in the 160s-170s.","color":"#597F5A"},{"id":"hernici","name":"Hernici","type":"league","family":"italic","start":-600,"end":-306,"color":"#A88B4A"},{"id":"heruli","name":"Heruli","type":"tribe","family":"germanic","start":260,"end":550,"color":"#5D855F"},{"id":"hibernians","name":"Irish (Scotti)","type":"confederation","family":"british","start":-600,"end":641,"color":"#587E5F"},{"id":"himyar","name":"Himyar","type":"kingdom","family":"semitic_arab","start":-110,"end":570,"color":"#A88A5A"},{"id":"homonadenses","name":"Homonadenses","type":"tribe","family":"anatolian","start":-100,"end":1,"summary":"Mountain people of the Taurus (Isauria/Pisidia) who killed king Amyntas of Galatia in 25 BC; subdued by Publius Sulpicius Quirinius, who reportedly took 44 strongholds.","color":"#8B9FB2"},{"id":"huns","name":"Huns","type":"nomadic","family":"steppe","start":370,"end":469,"color":"#8E7A3E"},{"id":"iazyges","name":"Iazyges","type":"tribe","family":"steppe","start":-100,"end":400,"color":"#B7A866"},{"id":"iberia_kartli","name":"Kingdom of Iberia (Kartli)","type":"kingdom","family":"caucasian","start":-299,"end":580,"color":"#7C8EAF"},{"id":"iberians","name":"Iberian peoples","type":"confederation","family":"iberian","start":-600,"end":-133,"color":"#C